# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.mypy_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Runtime data (history DBs, feedback logs, downloaded datasets)
/data/

# Trained model artifacts — too large for git; see scripts/
/models/*
# ...except the calibrated production profile that the RAID CI gate depends on
# (.github/workflows/raid.yml loads configs/.profile_master_minus_arxiv.yaml,
# which references these three files). Walk-down required: gitignore cannot
# re-include a file if a parent directory is excluded, so each level above
# the artifact files must be explicitly re-included before the leaf rules.
!/models/calib2000/
/models/calib2000/*
!/models/calib2000/profiles/
/models/calib2000/profiles/*
!/models/calib2000/profiles/master_minus_arxiv/
/models/calib2000/profiles/master_minus_arxiv/*
!/models/calib2000/profiles/master_minus_arxiv/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv/conformal.json
!/models/calib2000/profiles/master_minus_arxiv/detector_calibration.json
# A2-augmented variant ships alongside; same allowlist pattern.
!/models/calib2000/profiles/master_minus_arxiv_robust_v1/
/models/calib2000/profiles/master_minus_arxiv_robust_v1/*
!/models/calib2000/profiles/master_minus_arxiv_robust_v1/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv_robust_v1/ebm.pkl.hmac
!/models/calib2000/profiles/master_minus_arxiv_robust_v1/ebm.pkl.meta.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v1/conformal.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v1/detector_calibration.json
# SpecDetect-augmented variant (robust_v2). Same allowlist pattern.
!/models/calib2000/profiles/master_minus_arxiv_robust_v2/
/models/calib2000/profiles/master_minus_arxiv_robust_v2/*
!/models/calib2000/profiles/master_minus_arxiv_robust_v2/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv_robust_v2/ebm.pkl.hmac
!/models/calib2000/profiles/master_minus_arxiv_robust_v2/ebm.pkl.meta.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2/conformal.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2/detector_calibration.json
# robust_v2 follow-up ablation profiles (a/b/c/d). All four regressed
# vs robust_v1 -- kept on disk for inspection but not promoted.
!/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/
/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/*
!/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/ebm.pkl.hmac
!/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/ebm.pkl.meta.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/conformal.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2a_ablated/detector_calibration.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/
/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/*
!/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/ebm.pkl.hmac
!/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/ebm.pkl.meta.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/conformal.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2b_cascade/detector_calibration.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/
/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/*
!/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/ebm.pkl.hmac
!/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/ebm.pkl.meta.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/conformal.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2c_lowint/detector_calibration.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/
/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/*
!/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/ebm.pkl
!/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/ebm.pkl.hmac
!/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/ebm.pkl.meta.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/conformal.json
!/models/calib2000/profiles/master_minus_arxiv_robust_v2d_gated/detector_calibration.json

# Local editor / IDE
.vscode/
.idea/
.cursor/
*.swp

# Claude Code — ephemeral runtime locks (session/machine specific)
.claude/scheduled_tasks.lock

# OS
.DS_Store
Thumbs.db

# Scratch
ALL_FILES_DUMP.md

# Secrets — never commit. Put real keys in .env (gitignored, loaded
# by scripts/regenerate_llm_outputs.py). .env.example is the template.
.env
.env.local
.env.*.local